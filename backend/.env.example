# Copy to backend/.env and fill in your local values. Never commit the real .env.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=change_me
# dbDump.sql creates the schema under this exact name
DB_NAME=beerthusiasts

# Port the Express API listens on
API_PORT=5001
# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:3000
